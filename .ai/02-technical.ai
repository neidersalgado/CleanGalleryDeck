## 4. INTERFACES DEL DOMINIO

### Use Cases

```kotlin
interface GetMediaItemsUseCase {
    suspend operator fun invoke(filter: MediaFilter? = null): Flow<List<ContentItem>>
}

interface DeleteMediaUseCase {
    suspend operator fun invoke(item: ContentItem): Result<Unit>
}

interface KeepMediaUseCase {
    suspend operator fun invoke(item: ContentItem): Result<Unit>
}

interface GetAlbumsUseCase {
    suspend operator fun invoke(): Flow<List<Album>>
}

interface SyncGooglePhotosUseCase {
    suspend operator fun invoke(): Flow<List<ContentItem>>
}
```

### Repositories

```kotlin
interface MediaRepository {
    suspend fun getItems(filter: MediaFilter?): Flow<List<ContentItem>>
    suspend fun deleteItem(item: ContentItem): Result<Unit>
    suspend fun keepItem(item: ContentItem): Result<Unit>
}

interface AlbumRepository {
    suspend fun getAlbums(): Flow<List<Album>>
}

interface GooglePhotosRepository {
    suspend fun authenticate(): Result<Unit>
    suspend fun getPickerItems(): Flow<List<ContentItem>>
    suspend fun deleteItem(item: ContentItem): Result<Unit>
}
```

