## 5. APIs DE GOOGLE (Integración)

### Credential Manager (Autenticación)

```kotlin
class GoogleAuthManager @Inject constructor(private val context: Context) {
    suspend fun signIn(): Result<GoogleUser> {
        val credentialManager = CredentialManager.create(context)
        val request = GetCredentialRequest.Builder()
            .addCredentialOption(GoogleIdTokenCredentialOptions.Builder()
                .setClientId("YOUR_GOOGLE_CLIENT_ID")
                .build()
            )
            .build()
        return try {
            val result = credentialManager.getCredential(context, request)
            val credential = result.credential
            if (credential is GoogleIdTokenCredential) {
                Result.success(GoogleUser(credential.idToken))
            } else {
                Result.failure(Exception("Invalid credential type"))
            }
        } catch (e: Exception) {
            Result.failure(e)
        }
    }
}
```

### Google Photos Picker API

```kotlin
class GooglePhotosPicker @Inject constructor(private val context: Context) {
    suspend fun launchPicker(): Flow<List<ContentItem>> = callbackFlow {
        val pickerIntent = PhotosPickerIntentBuilder()
            .setMediaType(PhotosPickerMediaType.ALL)
            .setMaxItems(100)
            .build()
        // pickerLauncher.launch(pickerIntent)
    }
}
```

